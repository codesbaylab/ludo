# Copy to .env for local dev (never commit the real .env).

PORT=2567

# From the ludo-backend Supabase project (Settings -> API).
SUPABASE_URL=https://suojgcpxdelpvbfjcrfn.supabase.co
# Service role key — server-side only, bypasses RLS. Get it from the
# Supabase dashboard; never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Crypto deposits (USDT / USDC on Solana) - see server/README.md "Crypto deposits" ---
# A BIP39 mnemonic = the master key for every user's deposit address. Set it ONLY in Render's dashboard
# (or here for local testing with a throwaway devnet seed). Unset = crypto deposits disabled.
# Generate: node -e "console.log(require('bip39').generateMnemonic())"
SOLANA_MASTER_SEED=
# A Helius/QuickNode mainnet URL in production (the public RPC is rate-limited).
# For local testing: https://api.devnet.solana.com
SOLANA_RPC_URL=
# DEVNET TESTING ONLY - never set these on the live server. Test coin addresses that replace real USDT / USDC.
USDT_MINT_OVERRIDE=
USDC_MINT_OVERRIDE=
