# Copy to .env for local dev (never commit the real .env).

PORT=2567

# From the ludo-backend Supabase project (Settings -> API).
SUPABASE_URL=https://suojgcpxdelpvbfjcrfn.supabase.co
# Service role key — server-side only, bypasses RLS. Get it from the
# Supabase dashboard; never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Crypto deposits (USDT/TRC-20) — see server/README.md "Crypto deposits" ---
# A BIP39 mnemonic. THE master key controlling every user's deposit address.
# Generate one with `node -e "console.log(require('tronweb').TronWeb.createRandom().mnemonic.phrase)"`
# and set it ONLY in Render's dashboard env vars — never commit it, never log
# it, never put it anywhere else. Leaving this unset disables crypto deposits
# entirely (server logs a warning and moves on; nothing else breaks).
TRON_MASTER_SEED=
# Optional. Raises TronGrid's free-tier rate limit — get one at
# https://www.trongrid.io/. Not required to get started.
TRONGRID_API_KEY=
# Optional override for testing against Tron's Shasta/Nile testnet with a
# test TRC-20 token instead of real mainnet USDT. Leave unset for production.
USDT_CONTRACT_ADDRESS_OVERRIDE=
# Optional override for TronGrid's API base URL (e.g. a testnet-compatible
# mirror). Leave unset to use https://api.trongrid.io.
TRONGRID_API_BASE=
