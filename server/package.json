{
  "name": "ludo-server",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Authoritative realtime Ludo match server (Colyseus) + Supabase result persistence",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node build/index.js",
    "test:sim": "tsx src/test/simulateMatch.ts",
    "test:sim:rummy": "tsx src/test/simulateRummyMatch.ts",
    "test:rummy-engine": "tsx src/test/compareRummyEngine.ts",
    "sweep": "tsx src/tools/sweep.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.35",
    "@colyseus/ws-transport": "^0.15.3",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.45.4",
    "bip39": "^3.1.0",
    "colyseus": "^0.15.57",
    "cors": "^2.8.6",
    "ed25519-hd-key": "^2.0.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "colyseus.js": "^0.15.20",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
